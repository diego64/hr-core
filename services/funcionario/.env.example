# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info

# MongoDB — banco próprio do Funcionario Service
MONGO_URL=mongodb://localhost:27018
MONGO_DB_NAME=hr-funcionarios

# Auth — JWKS remoto do Auth Service (RS256, cache TTL 10min, cooldown 30s)
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json
AUTH_JWT_ISSUER=https://auth.hr-core.local
AUTH_JWT_AUDIENCE=hr-core

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_ROUTE_PREFIX=/docs

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# OpenTelemetry (tracing → Tempo via OTLP HTTP)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=funcionario
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Object storage — MinIO em dev (porta 9100), S3 em prod.
# S3_PUBLIC_ENDPOINT é usado APENAS para gerar presigned URLs alcançáveis
# pelo cliente final. Em compose o serviço fala com `minio:9000` (interno)
# mas o presigned aponta para `localhost:9100` (host).
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hr-funcionario-documentos
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900
